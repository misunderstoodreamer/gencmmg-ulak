# Genç MMG Etkinlik Onay Platformu — secrets iskeleti
#
# Yerel:           bu dosyayı .streamlit/secrets.toml olarak kopyalayıp doldurun (git'e eklenmez).
# Streamlit Cloud: Manage app → Settings → Secrets alanına aynı içeriği yapıştırın.
# "YOUR_" ile başlayan değerler boş kabul edilir; ilgili özellik kapalı kalır.

# --- Google Sheets (service account) ---------------------------------------
# Google Cloud → IAM → Service Accounts → Keys → JSON anahtarının alanları.
# Service account e-postasına Sheets dosyasında "Düzenleyici" yetkisi verin.
[gcp_service_account]
type = "service_account"
project_id = "YOUR_PROJECT_ID"
private_key_id = "YOUR_PRIVATE_KEY_ID"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
client_email = "YOUR_SERVICE_ACCOUNT@YOUR_PROJECT_ID.iam.gserviceaccount.com"
client_id = "YOUR_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/YOUR_SERVICE_ACCOUNT"

[sheets]
enabled = true
# Sheets URL'sindeki /d/ ile /edit arasındaki kısım
spreadsheet_id = "YOUR_SPREADSHEET_ID"

# --- Talep ekleri (Google Drive, Apps Script) -------------------------------
# Kurulum: README → "Talep ekleri". Boş bırakılırsa dosya yükleme kapalı olur,
# kullanıcılar yalnızca "dosya eklememe nedeni" yazarak talep gönderebilir.
[drive]
upload_url = "https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
upload_token = "YOUR_UPLOAD_TOKEN"

# --- E-posta (Gmail SMTP) ---------------------------------------------------
# Giriş kodları ve bildirimler bu hesaptan gider. Uygulama şifresi:
# https://myaccount.google.com/apppasswords (2 adımlı doğrulama açık olmalı)
[email]
sender = "YOUR_SENDER@gmail.com"
app_password = "YOUR_GMAIL_APP_PASSWORD"
# Yeni talep bildirimlerinin gideceği Genel Merkez adresi
merkez_email = "YOUR_HEADQUARTERS@gmail.com"

[auth]
otp_expire_minutes = 10

# --- Kullanıcılar -----------------------------------------------------------
# il_kodu: plaka kodu ("06" Ankara, "34" İstanbul ...); Genel Merkez için "00".
# Talep açabilen iller core/provinces.py içinde tanımlıdır.

# Yöneticiler: [admin] tek hesap, [[admins]] istenildiği kadar tekrarlanabilir.
[admin]
email = "YOUR_ADMIN@gmail.com"
il_kodu = "00"

[[admins]]
email = "YOUR_SECOND_ADMIN@gmail.com"
il_kodu = "00"

# İsteğe bağlı: Sheets'teki Kullanici_Rolleri sayfası dışında tanımlanan kullanıcılar.
# rol: Sube_Baskani | YK_Uyesi | Admin
[[users]]
email = "YOUR_BRANCH_PRESIDENT@gmail.com"
il_kodu = "34"
rol = "Sube_Baskani"

[[users]]
email = "YOUR_BOARD_MEMBER@gmail.com"
il_kodu = "00"
rol = "YK_Uyesi"
